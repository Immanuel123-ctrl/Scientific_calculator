<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Glass Button Style -->
    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:elevation">2dp</item>
        <item name="backgroundTint">@color/calc_surface_number</item>
        <item name="android:textColor">@color/calc_text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="rippleColor">#20FFC107</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="CalcButton.Number">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CalcButton.Function">
        <item name="backgroundTint">@color/calc_surface_function</item>
        <item name="android:textColor">@color/calc_text_primary</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="backgroundTint">#2D3A4F</item>
        <item name="android:textColor">@color/gold_glow</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButton.Equal">
        <item name="backgroundTint">@color/gold_glow</item>
        <item name="android:textColor">@color/bg_sapphire_deep</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CalcButton.Scientific">
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="backgroundTint">#141E2D</item>
        <item name="android:textColor">@color/calc_text_secondary</item>
    </style>

    <!-- Custom Menu Selector Item -->
    <style name="MenuSelectorText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>